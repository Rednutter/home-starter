[Unit]
Description=Home Starter local wake-word Assist satellite
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service pipewire-pulse.service wireplumber.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=%h/.local/share/home-starter/vendor/linux-voice-assistant
UMask=0077
ExecStartPre=/usr/bin/test -e /run/home-starter-voice-firewall-ready
ExecStart=%h/.local/share/home-starter/venv/bin/python -m linux_voice_assistant --name "Kitchen Wall Voice" --network-interface wlan0 --audio-input-device "UC02 Mono" --audio-output-device pipewire/alsa_output.usb-UC02_UC02_UC02-00.analog-stereo --music-output-device pipewire/alsa_output.platform-fe00b840.mailbox.stereo-fallback --wake-model hey_jarvis --preferences-file %h/.config/home-starter/voice-preferences.json --peripheral-host 127.0.0.1
Restart=always
RestartSec=10
NoNewPrivileges=yes

[Install]
WantedBy=default.target
