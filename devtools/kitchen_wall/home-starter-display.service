[Unit]
Description=Home Starter ambient wall browser
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=wayland-0
ExecStartPre=/usr/bin/test -S %t/wayland-0
ExecStartPre=-/usr/bin/wlr-randr --output HDMI-A-1 --transform 180
ExecStart=%h/.local/share/home-starter/venv/bin/python %h/.local/share/home-starter/display.py
Restart=always
RestartSec=10
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=default.target
