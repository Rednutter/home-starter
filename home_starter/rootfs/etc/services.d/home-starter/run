#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Home Starter web server (ingress only, port 8099).
# with-contenv makes SUPERVISOR_TOKEN available to the process; it is never
# printed or logged.
# ==============================================================================
bashio::log.info "Starting Home Starter..."
if bashio::config.true 'household_lan'; then
    export HOME_STARTER_HOUSEHOLD_LAN=true
    export HOME_STARTER_LAN_SURFACE="$(bashio::config 'household_lan_surface')"
    export HOME_STARTER_LAN_BINDING="$(bashio::config 'household_lan_binding')"
fi
exec python3 -m homestarter
