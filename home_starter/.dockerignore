# Build only product source. Runtime data, captures and developer files are excluded.
**
!Dockerfile
!server/
!server/requirements.txt
!server/homestarter/
!server/homestarter/*.py
!server/homestarter/static/
!server/homestarter/static/*.js
!server/homestarter/static/*.html
!server/homestarter/static/*.css
!server/homestarter/static/*.svg
!server/homestarter/static/wall-morning.jpg
!server/homestarter/static/wall-imagery.json
!server/homestarter/static/wallpapers.json
!server/homestarter/static/wallpapers/
!server/homestarter/static/wallpapers/morning-blue-hour.webp
!server/homestarter/static/wallpapers/morning-river-mist.webp
!server/homestarter/static/wallpapers/morning-granite-sunrise.webp
!server/homestarter/static/wallpapers/morning-coastal-dawn.webp
!server/homestarter/static/wallpapers/day-alpine-lake.webp
!server/homestarter/static/wallpapers/day-river-gums.webp
!server/homestarter/static/wallpapers/day-high-country.webp
!server/homestarter/static/wallpapers/day-coastal-bay.webp
!server/homestarter/static/wallpapers/afternoon-valley-light.webp
!server/homestarter/static/wallpapers/afternoon-riverbank.webp
!server/homestarter/static/wallpapers/afternoon-granite-country.webp
!server/homestarter/static/wallpapers/afternoon-coastal-grass.webp
!server/homestarter/static/wallpapers/evening-golden-hills.webp
!server/homestarter/static/wallpapers/evening-river-sunset.webp
!server/homestarter/static/wallpapers/evening-coastal-dusk.webp
!server/homestarter/static/wallpapers/evening-alpine-dusk.webp
!server/homestarter/static/wallpapers/night-moonlit-valley.webp
!server/homestarter/static/wallpapers/night-river-stars.webp
!server/homestarter/static/wallpapers/night-alpine-stars.webp
!server/homestarter/static/wallpapers/night-coastal-moon.webp
!rootfs/
!rootfs/etc/
!rootfs/etc/services.d/
!rootfs/etc/services.d/home-starter/
!rootfs/etc/services.d/home-starter/run
!rootfs/etc/services.d/home-starter/finish
